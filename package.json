{
  "name": "comet-launcher",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc --noEmit && vite build",
    "start": "bun run build && electron .",
    "test": "bun test",
    "test:electron": "bun run build && bun tests/run-electron-smoke.ts",
    "test:metadata": "bun tests/metadata-live.ts",
    "test:install": "bun tests/install-live.ts",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc --noEmit",
    "preview": "vite --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^40.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
